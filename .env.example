APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://question_brain:question_brain@localhost:55432/question_brain?sslmode=disable
PGPORT=55432
PAYLOAD_DATABASE_URL=postgres://question_brain:question_brain@localhost:55432/question_brain?sslmode=disable

# A model change creates a new profile and a backfill; it never mutates vectors in place.
EMBEDDING_PROFILE=semantic-v1
EMBEDDING_MODEL=local-or-provider-1024
EMBEDDING_DIMENSIONS=1024

