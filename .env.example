# Reserved host ports for this Compose project. Keep this set unique within
# the stack; container ports remain the standard 8080/5432/4317/4318/16686.
QB_HTTP_PORT=48127
QB_PG_PORT=55437
QB_JAEGER_UI_PORT=56686
QB_OTLP_GRPC_PORT=54317
QB_OTLP_HTTP_PORT=54318
QB_CMS_PORT=48128

APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://question_brain:question_brain@localhost:55437/question_brain?sslmode=disable
PGPORT=55437
PAYLOAD_DATABASE_URL=postgres://question_brain:question_brain@localhost:55437/question_brain?sslmode=disable
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:54317
PAYLOAD_SECRET=local-only-change-me
QUESTION_BRAIN_INTERNAL_TOKEN=local-promote-token

# A model change creates a new profile and a backfill; it never mutates vectors in place.
EMBEDDING_PROFILE=semantic-v1
EMBEDDING_MODEL=local-or-provider-1024
EMBEDDING_DIMENSIONS=1024
